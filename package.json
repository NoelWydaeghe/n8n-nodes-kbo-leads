{
  "name": "n8n-nodes-kbo-leads",
  "version": "1.1.0",
  "description": "n8n node for the KBO Leads API: search 1.8M Belgian companies by sector, region and filters",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "kbo",
    "bce",
    "belgium",
    "companies",
    "leads",
    "b2b",
    "prospecting",
    "nace"
  ],
  "license": "MIT",
  "author": {
    "name": "Noel Wydaeghe",
    "email": "noel@lokalegroei.be"
  },
  "homepage": "https://leads.lokalegroei.be/api",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoelWydaeghe/n8n-nodes-kbo-leads"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node build && n8n-node lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/KboLeadsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KboLeads/KboLeads.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.30.1",
    "@types/node": "^22.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.2",
    "n8n-workflow": "*",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
